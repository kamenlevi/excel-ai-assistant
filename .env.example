# ── LLM provider keys (set at least ONE — or paste your key into the in-app Settings panel after install) ──

# OpenRouter — easiest path. Get a key at https://openrouter.ai/keys (free tier works).
OPENROUTER_KEY=your_openrouter_key_here

# Groq — extremely fast inference. Get a key at https://console.groq.com/keys (free).
GROQ_KEY=your_groq_key_here

# ── Optional: additional provider keys (server-side fallback if user hasn't set one in-app) ──
# OPENAI_KEY=sk-...
# ANTHROPIC_KEY=sk-ant-...
# GOOGLE_AI_KEY=AIza...
# MISTRAL_KEY=...
# TOGETHER_KEY=...

# ── Optional: local models via Ollama or MLX ──
# Where Ollama / MLX is running. Default 127.0.0.1 = same machine as the server.
# Set to a LAN IP (e.g. 192.168.1.50) if Ollama runs on a different computer on your network.
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
MLX_PORT=8080

# ── Optional: cloud chat history sync (Supabase) ──
# Leave blank to keep everything local. If set, chats sync between devices.
SUPABASE_URL=
SUPABASE_ANON_KEY=
